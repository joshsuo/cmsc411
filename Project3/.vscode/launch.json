    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/sim_trace",
            "args": [
                "-t", "traces/4proc_validation",
                "-p", "MESI"
            ],
            "miDebuggerPath": "/usr/bin/gdb",
            "cwd": "."
        }
    ]
    
}